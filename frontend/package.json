{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate-api": "openapi-ts",
    "generate-icons": "tsx scripts/generate-icon-map.ts",
    "generate": "npm run generate-api && npm run generate-icons",
    "postinstall": "npm run generate-api",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@stomp/stompjs": "^7.3.0",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^26.1.0",
    "lucide-static": "^1.11.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6"
  }
}
