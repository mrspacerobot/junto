# Send only production build inputs. This allowlist keeps VCS metadata, local
# environment/secrets, dependencies, build output, tests, and tooling state out
# of every Docker build stage.
**

!Dockerfile

!docs/
!docs/openapi.json

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/openapi-ts.config.ts
!frontend/index.html
!frontend/postcss.config.js
!frontend/tailwind.config.js
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/public/
!frontend/public/**
!frontend/src/
!frontend/src/**
frontend/src/**/*.spec.*
frontend/src/**/*.test.*

!backend/
!backend/build.gradle
!backend/settings.gradle
!backend/gradlew
!backend/gradle/
!backend/gradle/**
!backend/src/
!backend/src/main/
!backend/src/main/**

# Main-source profile fixtures are useful to local development and tests, but
# are not production runtime inputs.
backend/src/main/resources/application-dev.yml
backend/src/main/resources/application-openapi.yml
backend/src/main/resources/application-test.yml
backend/src/main/resources/db/migration-dev/
