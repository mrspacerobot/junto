# Send only production build inputs. Everything is excluded by default; each
# line below re-includes exactly one production input. Dependencies, build
# output, tests, VCS metadata, and local secrets can never enter the context.
**

!Dockerfile
!docs/openapi.json

!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/openapi-ts.config.ts
!frontend/postcss.config.js
!frontend/tailwind.config.js
!frontend/vite.config.ts
!frontend/tsconfig*.json
!frontend/public/**
!frontend/src/**

!backend/build.gradle
!backend/settings.gradle
!backend/gradlew
!backend/gradle/**
!backend/src/main/**

# Re-exclusions that must win over the allowlist above: tests, non-production
# Spring profile fixtures and migrations, and local dotenv credentials.
frontend/src/api/generated/
**/*.spec.*
**/*.test.*
backend/src/main/resources/application-dev.yml
backend/src/main/resources/application-openapi.yml
backend/src/main/resources/application-test.yml
backend/src/main/resources/db/migration-dev/
**/.env
**/.env.*
